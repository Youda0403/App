<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 다른 앱 위에 캐릭터 창을 띄우기 위한 특별 권한 (설정 화면에서 사용자가 직접 허용) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 오버레이가 살아 있는 동안 상시 알림을 띄우는 포그라운드 서비스 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Android 13+ 알림 표시 런타임 권한. 거절해도 오버레이 자체는 동작한다. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".PairPlayApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.PairPlay">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.PairPlay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            오버레이가 떠 있는 동안 살아 있는 포그라운드 서비스.
            Android 14 이상은 유형 선언이 필수인데, 다른 앱 위에 캐릭터를 띄우는 일은
            기존 유형(미디어 재생/위치/통화 등) 어디에도 해당하지 않아 specialUse 를 쓴다.
        -->
        <service
            android:name=".overlay.OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="사용자가 직접 시작한 화면 위 캐릭터 오버레이를 유지하기 위한 서비스입니다. 서비스가 살아 있는 동안에만 캐릭터가 표시되며, 사용자는 상시 알림에서 즉시 중지할 수 있습니다." />
        </service>

        <!--
            알림을 읽기 위한 것이 아니라, MediaSessionManager.getActiveSessions() 호출 조건을
            충족하기 위해 존재한다. 사용자가 설정에서 직접 켜야만 동작한다.
        -->
        <service
            android:name=".music.PairPlayNotificationListener"
            android:exported="false"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>


        <!--
            홈 화면 위젯. 오버레이와 같은 데이터베이스를 읽으므로 설정이 따로 놀지 않는다.
            시스템이 직접 이 컴포넌트를 지정해 부르므로 밖으로 열어 둘 필요가 없다.
        -->
        <receiver
            android:name=".widget.PairPlayWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

    </application>

</manifest>
